include @scripts/accel_isolated.resc
include @scripts/register_ids.py
python "from System import Array, Byte"
python "dev = monitor.Machine['sysbus.accel']"

# DS11811 Rev. 9, sections 8.4 and 8.11: power-down blocks new samples.
python "dev.Write(Array[Byte]([RegisterId.CTRL1]))"
python "assert list(dev.Read(1)) == [0x00], 'CTRL1 reset value mismatch'"
python "dev.FinishTransmission(); dev.Write(Array[Byte]([RegisterId.STATUS]))"
python "assert list(dev.Read(1)) == [0x00], 'DRDY must be clear in power-down'"
python "dev.FeedAccelerationSample(acceleration_g('0.0976'), acceleration_g('-0.1952'), acceleration_g('0.976'))"
python "assert dev.SampleX == 0 and dev.SampleY == 0 and dev.SampleZ == 0, 'power-down accepted a sample'"

# A non-zero ODR enables acquisition but does not invent a completed sample.
python "dev.FinishTransmission(); dev.Write(Array[Byte]([RegisterId.CTRL1, 0x20]))"
python "dev.FinishTransmission(); dev.Write(Array[Byte]([RegisterId.CTRL1]))"
python "assert list(dev.Read(1)) == [0x20], 'CTRL1 ODR write mismatch'"
python "dev.FinishTransmission(); dev.Write(Array[Byte]([RegisterId.STATUS]))"
python "assert list(dev.Read(1)) == [0x00], 'ODR alone must not set DRDY'"

# FeedAccelerationSample represents a completed conversion. STATUS remains set until an
# axis high byte is read, matching the default latched data-ready behavior.
python "dev.FeedAccelerationSample(acceleration_g('0.0976'), acceleration_g('-0.1952'), acceleration_g('0.976'))"
python "assert dev.SampleX == 1600 and dev.SampleY == -3200 and dev.SampleZ == 16000, 'active acquisition rejected a sample'"
python "dev.FinishTransmission(); dev.Write(Array[Byte]([RegisterId.STATUS]))"
python "assert list(dev.Read(1)) == [0x01], 'new sample did not set DRDY'"
python "dev.FinishTransmission(); dev.Write(Array[Byte]([RegisterId.OUT_X_H]))"
python "dev.Read(1)"
python "dev.FinishTransmission(); dev.Write(Array[Byte]([RegisterId.STATUS]))"
python "assert list(dev.Read(1)) == [0x00], 'axis high-byte read did not clear DRDY'"

# Power-down clears a pending event and prevents later sample updates.
python "dev.FeedAccelerationSample(acceleration_g('-0.000976'), acceleration_g('0.001952'), acceleration_g('-0.002928'))"
python "dev.FinishTransmission(); dev.Write(Array[Byte]([RegisterId.CTRL1, 0x00]))"
python "dev.FinishTransmission(); dev.Write(Array[Byte]([RegisterId.STATUS]))"
python "assert list(dev.Read(1)) == [0x00], 'DRDY did not clear in power-down'"
python "dev.FeedAccelerationSample(acceleration_g('0.006832'), acceleration_g('0.007808'), acceleration_g('0.008784'))"
python "assert dev.SampleX == -16 and dev.SampleY == 32 and dev.SampleZ == -48, 'power-down changed XYZ'"

echo "PASS sample_acquisition: power-down and DRDY lifecycle"
quit
