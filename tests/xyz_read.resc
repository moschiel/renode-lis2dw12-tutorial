include @scripts/accel_isolated.resc
include @scripts/register_ids.py
python "from System import Array, Byte"
python "dev = monitor.Machine['sysbus.accel']"

# DS11811 Rev. 9, Table 21: all output registers reset to zero.
python "dev.Write(Array[Byte]([RegisterId.OUT_X_L]))"
python "assert list(dev.Read(1)) == [0], 'OUT_X_L reset value mismatch'"
python "assert [int(dev.SampleX), int(dev.SampleY), int(dev.SampleZ)] == [0, 0, 0], 'XYZ reset values mismatch'"

# The input is expressed in g. The default 12-bit mode converts it to
# X=1600 (0x0640), Y=-3200 (0xF380), Z=16000 (0x3E80).
python "dev.FinishTransmission()"
python "if hasattr(dev, 'AcquisitionEnabled'): dev.WriteRegister(RegisterId.CTRL1, 0x20)"
python "dev.FeedAccelerationSample(acceleration_g('0.0976'), acceleration_g('-0.1952'), acceleration_g('0.976'))"
python "dev.Write(Array[Byte]([RegisterId.OUT_X_L]))"
python "xLow = list(dev.Read(1))[0]"
python "dev.FinishTransmission(); dev.Write(Array[Byte]([RegisterId.OUT_X_H]))"
python "xHigh = list(dev.Read(1))[0]"
python "dev.FinishTransmission(); dev.Write(Array[Byte]([RegisterId.OUT_Y_L]))"
python "yLow = list(dev.Read(1))[0]"
python "dev.FinishTransmission(); dev.Write(Array[Byte]([RegisterId.OUT_Y_H]))"
python "yHigh = list(dev.Read(1))[0]"
python "dev.FinishTransmission(); dev.Write(Array[Byte]([RegisterId.OUT_Z_L]))"
python "zLow = list(dev.Read(1))[0]"
python "dev.FinishTransmission(); dev.Write(Array[Byte]([RegisterId.OUT_Z_H]))"
python "zHigh = list(dev.Read(1))[0]"
python "assert [xLow, xHigh, yLow, yHigh, zLow, zHigh] == [0x40, 0x06, 0x80, 0xF3, 0x80, 0x3E], 'XYZ individual encoding mismatch'"
python "assert [int(dev.SampleX), int(dev.SampleY), int(dev.SampleZ)] == [1600, -3200, 16000], 'XYZ model state mismatch'"

# Output registers are read-only to the I2C master.
python "dev.FinishTransmission()"
python "dev.Write(Array[Byte]([RegisterId.OUT_X_L, 0x00, 0x00]))"
python "dev.FinishTransmission()"
python "dev.Write(Array[Byte]([RegisterId.OUT_X_L]))"
python "assert list(dev.Read(1)) == [0x40], 'XYZ output registers must not be writable'"

python "dev.Reset()"
python "dev.Write(Array[Byte]([RegisterId.OUT_X_L]))"
python "assert list(dev.Read(1)) == [0], 'hardware reset did not clear OUT_X_L'"
python "assert [int(dev.SampleX), int(dev.SampleY), int(dev.SampleZ)] == [0, 0, 0], 'hardware reset did not clear XYZ outputs'"

echo "PASS xyz_read: signed XYZ output registers"
quit
